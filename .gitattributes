# 统一换行：仓库内一律 LF，避免 Windows 检出产生整库 diff
* text=auto eol=lf

# 二进制资源不参与换行转换
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.gz binary

# 脚本必须 LF（Linux 部署机执行）
*.sh text eol=lf

# PowerShell 脚本按 Windows 惯例 CRLF
*.ps1 text eol=crlf
