# ModernChat 后端配置（复制为 .env 后修改；生产环境务必逐项检查）

# HTTP 监听端口
PORT=8080

# gin 模式：debug | release（生产必须 release）
GIN_MODE=release

# MySQL DSN（utf8mb4 必须；parseTime/loc 固定写法）
DB_DSN=root:root@tcp(127.0.0.1:3306)/modernchat?charset=utf8mb4&parseTime=True&loc=Local

# JWT 签名密钥：≥32 字节随机串。生产模式（GIN_MODE=release）必须显式设置，否则拒绝启动。
# 生成示例：openssl rand -hex 32
JWT_SECRET=

# 前端来源（逗号分隔）：WS Origin 白名单 + 找回密码链接前缀
FRONTEND_URL=http://localhost:5173

# Redis（可选）：配置后限流使用共享配额；连接失败自动降级为内存限流
# 留空 REDIS_ADDR 即完全禁用
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 日志目录（相对 server/ 运行目录）与保留天数；留空 LOG_DIR 则只输出 stdout
LOG_DIR=logs
LOG_RETAIN_DAYS=15

# true 时启动执行 migrations/ 版本化 SQL（生产）；false 用 GORM AutoMigrate（开发）
MIGRATE=false

# 插件文件大小上限（字节），默认 1MB
PLUGIN_MAX_SIZE=1048576

# ---- 找回密码邮件（可选）。全部留空时重置链接打印到服务端日志 ----
# 端口：465 = 隐式 TLS（QQ / 163 等推荐）；587 = STARTTLS 升级
# QQ / 163 需填写「SMTP 授权码」而非登录密码，且 SMTP_FROM 必须与 SMTP_USER 一致，否则被拒信
# 示例：smtp.qq.com : 465 : you@foxmail.com : 授权码 : you@foxmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 未配置 SMTP 时，是否把完整的重置链接写进日志。
# 默认：GIN_MODE=release 关闭（日志里出现可用令牌=账户接管入口），其他模式开启。
# 生产若确实要靠日志取链接，显式设为 true，并确保日志不落第三方平台。
LOG_RESET_LINK=
