# ModernChat 服务端配置（环境变量版；复制为 .env 后按需修改）
# 说明：install.sh 一键安装会自动生成 .env，本文件供手工部署参考。
# 优先级：真实环境变量 > .env（godotenv 仅在环境变量未设置时生效）。
# 必填项只有 DB_DSN / JWT_SECRET / FRONTEND_URL，其余全部可选。

# ---------- 必填 ----------

# 监听端口
PORT=8080

# MySQL 连接串（必填）。示例：
# DB_DSN=modernchat:密码@tcp(127.0.0.1:3306)/modernchat?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=

# JWT 签名密钥（必填，≥32 字节）。生成：openssl rand -hex 32
# 注意：它是 system_settings 敏感项的加密密钥，更换后需在后台重填 SMTP/Redis/存储密码。
JWT_SECRET=

# 允许的前端来源（逗号分隔，用于 WS Origin 校验与找回密码链接，末尾不带斜杠）
FRONTEND_URL=http://localhost:5173

# ---------- 运行模式 ----------

# release=生产（缺省）；debug=开发（JWT_SECRET 缺省时自动生成随机值）
#GIN_MODE=release

# 日志级别：debug | info | warn | error
#LOG_LEVEL=info

# 日志目录（留空只输出 stdout）
#LOG_DIR=logs

# 上传文件数据目录（相对进程工作目录或绝对路径）
#DATA_DIR=data

# 日志保留天数
#LOG_RETAIN_DAYS=15

# 启动时自动执行迁移（true/false）
#MIGRATE=false

# ---------- 网络与安全 ----------

# 可信反向代理网段（逗号分隔）。默认只信任本机回环（nginx 同机部署）；
# 设为空串表示不信任任何代理
#TRUSTED_PROXIES=127.0.0.1,::1

# /api/metrics 的 Bearer Token（留空=关闭该接口）
#METRICS_TOKEN=

# ---------- 在线更新（站长后台 → 在线更新） ----------
# 两项都配置 = 发行版模式（下载 GitHub Release 预编译包，服务器无需 Go/Node/git）；
# 都留空 = 安装目录有 .git 时走源码模式（git pull 后本地编译），
#          否则按 RELEASE_REPO_GITHUB（或默认官方仓库）派生 GitHub Release 地址兜底。
# install.sh 会自动写入（默认官方仓库）：
#   RELEASE_API_URL=https://api.github.com/repos/modern-day-team/modern-chat-new/releases/latest
#   RELEASE_DL_URL=https://github.com/modern-day-team/modern-chat-new/releases/download
#RELEASE_API_URL=
#RELEASE_DL_URL=

# Release 托管仓库（owner/repo；RELEASE_API_URL/RELEASE_DL_URL 未配置时用它派生），
# Release 放在 fork / 镜像仓库时配置
#RELEASE_REPO_GITHUB=modern-day-team/modern-chat-new

# GitHub API 令牌（可选）：匿名 api.github.com 限流 60 次/小时/IP，配置后提升到
# 5000 次/小时；也可支持私有仓库的 Release 检查。仅随更新请求发送，不落日志
#GITHUB_TOKEN=

# 站长后台图形化更新开关（默认开；不信任多管理员环境可设为 false 整体关闭）
#WEB_UPDATE=true

# ---------- 数据库备份 ----------

# 自动备份间隔小时数（0=关闭）
#BACKUP_INTERVAL_HOURS=0

# 备份保留份数（默认 7）
#BACKUP_RETAIN=7

# 备份目录（默认 <DATA_DIR>/backups）
#BACKUP_DIR=

# mysqldump 可执行文件路径
#MYSQLDUMP_PATH=mysqldump

# ---------- 可选能力（也可装完在「后台 → 系统设置」里配置） ----------

# Redis：配置后限流使用共享配额，连接失败自动降级为内存
#REDIS_ADDR=
#REDIS_PASSWORD=
#REDIS_DB=0

# SMTP：找回密码邮件发送（四项都配置才启用）
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=modernchat@localhost
# 未配置 SMTP 时是否把完整重置链接写进日志（仅限本地开发调试）
#LOG_RESET_LINK=false

# Web Push（VAPID）：三项都配置才启用
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# ---------- 旧站迁移（两项都配置才启用；任一留空则迁移接口统一返回 503） ----------
# 与旧站 chat/migrate_config.php 中的共享密钥一致（≥32 字节，建议 openssl rand -hex 32）
#LEGACY_API_SECRET=
# 旧站 chat 库只读连接串（建议用只读账号；新站会懒建第二个连接，只执行 SELECT）
#LEGACY_DB_DSN=legacy_ro:密码@tcp(127.0.0.1:3306)/chat?charset=utf8mb4&parseTime=True&loc=Local

# ---------- 在线音乐（musicd 音源运行时，详见 docs/在线音乐与自定义音源.md） ----------
# musicd 是本机 Node 服务（server/musicd/，仅监听 127.0.0.1:8310），负责把歌名解析成
# 第三方直链，音频字节由浏览器直连音源下载，不经过本服务器。未部署 musicd 时
# 聊天室的「在线音乐」标签页自动隐藏，其余功能不受影响。
#MUSICD_ENDPOINT=http://127.0.0.1:8310
# 与 musicd 共享的密钥（请求头 X-Music-Key；建议 openssl rand -hex 32，musicd 侧同值）
#MUSICD_KEY=
# 旧播放器端点兜底（musicd 不可用时仍能解析直链；两项都配置才启用，可留空）
#CHAT_MUSIC_ENDPOINT=
#CHAT_MUSIC_KEY=

# ---------- 统一登录（聚合登录中心，四项都配置才启用） ----------
# 本站对外地址（用于拼回调与回跳页，如 https://chat.example.com）
#SSO_SITE_URL=
# 前端挂载前缀（与 vite base 一致；站点根部署时设为空）
#SSO_APP_BASE=/app
# 聚合登录中心地址（提供 /oauth/authorize、/api/oauth/token、/api/oauth/userinfo）
#SSO_HUB_URL=
# 中心为本站签发的客户端凭据
#SSO_CLIENT_ID=
#SSO_CLIENT_SECRET=

# ---------- 限额 ----------

# 插件包最大体积（字节，默认 1 MiB）
#PLUGIN_MAX_SIZE=1048576
