# ModernChat 服务端配置（环境变量版；复制为 .env 后按需修改）
# 说明：install.sh 一键安装会自动生成 .env，本文件供手工部署参考。
# 优先级：真实环境变量 > .env（godotenv 仅在环境变量未设置时生效）。
# 必填项只有 DB_DSN / JWT_SECRET / FRONTEND_URL，其余全部可选。

# ---------- 必填 ----------

# 监听端口
PORT=8080

# MySQL 连接串（必填）。示例：
# DB_DSN=modernchat:密码@tcp(127.0.0.1:3306)/modernchat?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=

# JWT 签名密钥（必填，≥32 字节）。生成：openssl rand -hex 32
# 注意：它是 system_settings 敏感项的加密密钥，更换后需在后台重填 SMTP/Redis/存储密码。
JWT_SECRET=

# 允许的前端来源（逗号分隔，用于 WS Origin 校验与找回密码链接，末尾不带斜杠）
FRONTEND_URL=http://localhost:5173

# ---------- 运行模式 ----------

# release=生产（缺省）；debug=开发（JWT_SECRET 缺省时自动生成随机值）
#GIN_MODE=release

# 日志级别：debug | info | warn | error
#LOG_LEVEL=info

# 日志目录（留空只输出 stdout）
#LOG_DIR=logs

# 上传文件数据目录（相对进程工作目录或绝对路径）
#DATA_DIR=data

# 日志保留天数
#LOG_RETAIN_DAYS=15

# 启动时自动执行迁移（true/false）
#MIGRATE=false

# ---------- 网络与安全 ----------

# 可信反向代理网段（逗号分隔）。默认只信任本机回环（nginx 同机部署）；
# 设为空串表示不信任任何代理
#TRUSTED_PROXIES=127.0.0.1,::1

# /api/metrics 的 Bearer Token（留空=关闭该接口）
#METRICS_TOKEN=

# ---------- 在线更新（站长后台 → 在线更新） ----------
# 两项都配置 = 发行版模式（下载 Release 预编译包，服务器无需 Go/Node/git）；
# 都留空 = 源码 git 模式（安装目录有 .git 时，git pull 后本地编译）。
# install.sh 会按 RELEASE_SOURCE 自动写入：
#   RELEASE_API_URL=https://gitee.com/api/v5/repos/Sun-Si-Cheng/modern-chat-new/releases/latest
#   RELEASE_DL_URL=https://gitee.com/Sun-Si-Cheng/modern-chat-new/releases/download
#RELEASE_API_URL=
#RELEASE_DL_URL=

# 站长后台图形化更新开关（默认开；不信任多管理员环境可设为 false 整体关闭）
#WEB_UPDATE=true

# ---------- 数据库备份 ----------

# 自动备份间隔小时数（0=关闭）
#BACKUP_INTERVAL_HOURS=0

# 备份保留份数（默认 7）
#BACKUP_RETAIN=7

# 备份目录（默认 <DATA_DIR>/backups）
#BACKUP_DIR=

# mysqldump 可执行文件路径
#MYSQLDUMP_PATH=mysqldump

# ---------- 可选能力（也可装完在「后台 → 系统设置」里配置） ----------

# Redis：配置后限流使用共享配额，连接失败自动降级为内存
#REDIS_ADDR=
#REDIS_PASSWORD=
#REDIS_DB=0

# SMTP：找回密码邮件发送（四项都配置才启用）
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=modernchat@localhost
# 未配置 SMTP 时是否把完整重置链接写进日志（仅限本地开发调试）
#LOG_RESET_LINK=false

# Web Push（VAPID）：三项都配置才启用
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# ---------- 限额 ----------

# 插件包最大体积（字节，默认 1 MiB）
#PLUGIN_MAX_SIZE=1048576
