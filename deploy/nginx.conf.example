# ModernChat Nginx 配置示例
# 前端：npm run build 产物部署到 /var/www/modernchat
# 后端：Go 服务监听 127.0.0.1:8080

server {
    listen 80;
    server_name your-domain.com;

    root /var/www/modernchat;
    index index.html;

    # ===== 压缩 =====
    # 优先发送预压缩文件（npm run build 会同时产出 .gz / .br），**零运行时 CPU**；
    # 找不到同名预压缩文件时，回落到底下的 gzip 实时压缩。
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/javascript application/javascript
        application/json application/xml image/svg+xml;
    gzip_static on;

    # brotli 比 gzip 再省约 13%，但官方 nginx 未内置该模块。
    # 启用前先确认：nginx -V 2>&1 | grep -i brotli
    # 确认有模块后再取消注释：
    # brotli on;
    # brotli_static on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

    # ===== 安全响应头（nginx 侧必须配，API 响应头由后端中间件负责）=====
    # X-Frame-Options：禁止本站被 iframe 嵌套，防点击劫持（诱导站长点「封禁/删除」）
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # CSP 模板：**默认注释掉**。插件沙箱用 iframe srcdoc + 内联脚本运行插件代码，
    # srcdoc 会继承父页面 CSP，若 script-src 不含 'unsafe-inline' 插件系统会整体失效。
    # 修改插件运行机制（如改为外链沙箱页）之后再启用下面这行：
    # add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # 前端静态资源（SPA history 路由回退）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带指纹的静态资源长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # REST API
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;   # 插件上传 1MB + 余量
    }

    # WebSocket（/ws 握手 + 升级）
    location /ws {
        # 浏览器无法为 WebSocket 自定义请求头，token 只能走 query（?token=...）。
        # 若按默认 access_log 记录完整 URI，日志里会留下**可用令牌**（CWE-598）：
        # 任何能读日志的人都能拿它劫持会话。因此关闭该路径的访问日志。
        access_log off;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;   # 心跳 25s，留足余量
        proxy_send_timeout 300s;
    }
}
